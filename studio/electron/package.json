{
  "name": "mnemion-studio",
  "version": "4.2.3",
  "description": "Mnemion Studio - shared app and team memory with Obsidian visualization",
  "author": {
    "name": "PERSEUS LEGACY LIMITED",
    "email": "Perseusxrltd@users.noreply.github.com",
    "url": "https://github.com/Perseusxrltd"
  },
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron .",
    "build": "node scripts/build.mjs",
    "build:resources": "node scripts/build-resources.mjs",
    "verify:resources": "node scripts/verify-resources.mjs",
    "verify:installer": "node scripts/verify-installer.mjs",
    "smoke:packaged": "node scripts/smoke-packaged-app.mjs",
    "pack": "npm run build:resources && npm run build && npm run verify:resources && electron-builder --config builder.config.cjs --publish never --dir",
    "dist": "npm run build:resources && npm run build && npm run verify:resources && electron-builder --config builder.config.cjs --publish never && npm run verify:installer",
    "dist:prepackaged": "electron-builder --config builder.config.cjs --publish never --win nsis --prepackaged ../../dist-electron/win-unpacked && npm run verify:installer",
    "test": "npm run build && node --test scripts/test-update-policy.mjs scripts/test-linux-startup.mjs scripts/test-macos-updates.mjs scripts/test-windows-updates.mjs scripts/test-credential-process.mjs scripts/test-workspace-cipher.mjs scripts/test-workspace-store.mjs scripts/test-workspace-connections.mjs scripts/test-workspace-sign-in.mjs scripts/test-workspace-fetch.mjs scripts/test-local-workspace.mjs && node --experimental-test-module-mocks --test scripts/test-update-controller.mjs",
    "smoke:installed-hosting": "node scripts/smoke-installed-hosting.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.perseusxr.mnemion-studio",
    "productName": "Mnemion Studio",
    "copyright": "Copyright 2026 PERSEUS LEGACY LIMITED",
    "compression": "store",
    "directories": {
      "output": "../../dist-electron"
    },
    "files": [
      "dist/**",
      "!dist/*.map"
    ],
    "extraResources": [
      {
        "from": "../../build-tmp/notices",
        "to": "licenses",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../dist-client/mnemion-client",
        "to": "client",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../frontend/dist-desktop",
        "to": "frontend/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../build-tmp/native-resources",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ]
      },
      "verifyUpdateCodeSignature": true,
      "target": [
        "nsis"
      ],
      "icon": "../frontend/public/icon.ico",
      "artifactName": "Mnemion-Studio-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "../frontend/public/icon.ico",
      "uninstallerIcon": "../frontend/public/icon.ico",
      "installerHeaderIcon": "../frontend/public/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mnemion Studio"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "../frontend/public/icon.icns",
      "category": "public.app-category.productivity",
      "artifactName": "Mnemion-Studio-${version}-macos-${arch}.${ext}",
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "../frontend/public/icon.png",
      "category": "Office",
      "artifactName": "Mnemion-Studio-${version}-linux-${arch}.${ext}",
      "executableName": "mnemion-studio",
      "syncDesktopName": true
    }
  },
  "homepage": "https://github.com/Perseusxrltd/mnemion",
  "license": "MIT",
  "desktopName": "com.perseusxr.mnemion-studio.desktop",
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
