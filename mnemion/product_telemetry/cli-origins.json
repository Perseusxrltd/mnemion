    "obsidian sync": {"selector": "mode", "variants": {"apply": "memory.export"}, "variant_exclusions": {"preview": "configuration_preview"}, "completion": "success", "read_only": false},
    "obsidian setup": {"selector": "mode", "variants": {"apply": "memory.export"}, "variant_exclusions": {"preview": "configuration_preview"}, "completion": "success", "read_only": false},
    "status": {"exclusion": "state_inspection"},
    "source status": {"exclusion": "state_inspection"},
    "obsidian status": {"exclusion": "state_inspection"},
    "obsidian open": {"exclusion": "external_application"},
    "llm status": {"exclusion": "state_inspection"},
    "instructions init": {"exclusion": "instructions"},
