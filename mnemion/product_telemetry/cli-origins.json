    "wiki blast-radius": {"exclusion": "lookup_or_preview"},
    "wiki diff": {"exclusion": "lookup_or_preview"},
    "wiki status": {"exclusion": "state_inspection"},
    "wiki open": {"exclusion": "state_inspection"},
    "search": {"workflow": "memory.recall", "completion": "success", "read_only": true},
    "wake-up": {"workflow": "memory.context", "completion": "success", "read_only": true},
    "reconstruct": {"workflow": "memory.knowledge", "completion": "success", "read_only": true},
