  "contribution": {
    "weight_per_metric": 1,
    "denominator_weight": 1,
    "clip_per_bucket": 255,
    "maximum_observations": 512,
    "weighting": "one_clipped_normalized_tick_per_metric_not_uncapped_events"
  },
  "admission": {
    "rule": "every_well_formed_report",
    "cross_report_eviction": false,
    "per_report_clip": "one_tick_per_metric_after_clip_255"
  },
  "privacy": {
    "unit": "add_or_remove_one_input_report_including_admission_and_clipping",
    "epsilon": "ln(3)",
    "l1_sensitivity": 20,
    "noise": {
      "distribution": "difference_of_two_geometrics",
      "continue_numerator": 16452,
      "continue_denominator": 17381
    },
    "publication_rounding": 1,
    "suppression_noisy_denominator": 64,
    "singleton_suppression": false
  },
  "client_budget": {
    "minimum_attempt_spacing_seconds": 86400,
    "maximum_attempts_per_rolling_week": 7,
    "maximum_packet_bytes": 25,
