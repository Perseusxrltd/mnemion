{
  "version": 2,
  "mechanism": "signed_hadamard_coordinate",
  "truth_probability": {
    "numerator": 3,
    "denominator": 4
  },
  "protected_unit": "One automatically sampled categorical value in the chosen permitted view; reviewed packets carry no categorical value. Participation, policy choice and lifetime history are not protected.",
  "packet": {
    "bytes": 4,
    "fields": [
      "version",
      "view",
      "coordinate",
      "flags"
    ],
    "flags": {
      "positive_sign_bit": 1,
      "reviewed_report_bit": 2,
      "allowed_values": [
        0,
        1,
        2
      ]
    },
    "reviewed_body": {
      "view": "first_permitted_view",
      "coordinate": 0,
      "flags": 2,
      "measurement_category": "not_transmitted"
    }
  },
  "maximum_rows": 512,
  "maximum_cell_count": 255,
  "maximum_report_bytes": 4,
  "reporting": {
    "schema_version": 3,
    "minimum_reports_per_window": 64,
    "minimum_reports_per_view": 4096,
    "maximum_reports_per_window": 10000000,
    "simultaneous_error_probability": 0.05,
    "minimum_report_bucket": 4096,
    "window_seconds": 604800,
    "retained_windows": 8,
    "estimation_population": "automatic_reports_only",
    "reviewed_report_use": "coarse_global_volume_only"
  },
  "budget_proposal": {
    "minimum_attempt_spacing_seconds": 86400,
    "maximum_attempts_per_rolling_week": 7,
    "privacy_loss_per_report": "ln(3)",
    "privacy_loss_per_rolling_week_upper_bound": "7 * ln(3)",
    "wire_reservation_per_attempt_bytes": 65536,
    "status": "requires shared budget, transport and release qualification",
    "privacy_bound_scope": "automatic_categorical_reports_with_packet_independent_inclusion"
  },
  "views": [
