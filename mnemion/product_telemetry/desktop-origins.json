    "state_inspection": "Status, discovery and polling do not identify a new user workflow.",
    "configuration_preview": "Internal setup validation and secret previews are not product usage observations.",
    "privacy_control": "Privacy controls are not measured. Explicit report inspection may stage already-permitted aggregates without sending them.",
    "secondary_receipt_owner": "A host request is observed only when its authenticated reply marks this intake new; old, missing or unrecognized dispositions remain unmeasured.",
    "recovery_transport": "Inspecting, archiving or cancelling a recovery receipt does not repeat the original operation.",
    "automatic_connection": "Restoring the remembered desktop connection or returning its active session is not a fresh explicit workspace action.",
    "authentication_transport": "Cancelling credential acquisition belongs to its existing sign-in operation, without a separate usage observation.",
    "delegated_alias": "The enclosing Studio action owns its service or vault transport; this bridge adds no second observation."
  },
