#ifndef MNEMION_PARENT_PIN_H
#define MNEMION_PARENT_PIN_H
/* Parent-only exact-helper pins. The manual recipe writes
   generated/parent_pin.h from the already signed and frozen helper.
   The helper binary must not include this header. See STAGED_BUILD.md.
   Required macros, all ordinary C string literals:
     MNEMION_HELPER_CDHASH exactly 40 or 64 uppercase hex characters
     MNEMION_HELPER_MANIFEST_SHA256 exactly 64 lowercase hex characters
       from bundle_manifest_digest, not a tar or ZIP hash
     MNEMION_SEALED_HELPER_IDENTIFIER the helper bundle identifier
     MNEMION_HELPER_DESIGNATED the helper designated requirement, one line
   Caller certificate pins live in caller_pin.h. Compile-only placeholders
   are refused at process start. They are not runtime pins. */
#error "Unsubstituted parent helper pin. Freeze the signed helper, then write this header."
#endif
