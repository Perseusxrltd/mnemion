[Unit]
Description=Perseus XR Mnemion anonymous aggregate collector
After=network-online.target mnemion-telemetry.socket
Wants=network-online.target
Requires=mnemion-telemetry.socket
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=mnemion-telemetry
Group=mnemion-telemetry
StateDirectory=mnemion-telemetry
StateDirectoryMode=0700
WorkingDirectory=/opt/mnemion-telemetry/source
Environment=PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
# legacy is the installed default. The optional v3 drop-in overrides this one variable.
Environment=MNEMION_TELEMETRY_MODE=legacy
UnsetEnvironment=SSLKEYLOGFILE PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONINSPECT
ExecStart=/opt/mnemion-telemetry/venv/bin/python -m mnemion.product_telemetry.server serve --mode ${MNEMION_TELEMETRY_MODE} --state /var/lib/mnemion-telemetry --bind 0.0.0.0 --port 8443 --certificate %d/tls.pem --private-key %d/tls.pem --systemd-socket
# One atomically replaced bundle prevents mixed certificate/key generations.
# No workspace credential or authentication header belongs in this service.
LoadCredential=tls.pem:/etc/mnemion-telemetry/tls.pem
UMask=0077
Restart=on-failure
RestartSec=10
TimeoutStopSec=8
LimitCORE=0
LimitNOFILE=128
TasksMax=16
MemoryMax=128M
MemorySwapMax=0
CPUQuota=25%
CapabilityBoundingSet=
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# PID 1 supplies the sole listener. These restrictions work without cgroup BPF.
SystemCallFilter=~connect bind
SystemCallErrorNumber=EPERM
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
