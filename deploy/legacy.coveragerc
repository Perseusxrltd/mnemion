# Service and native-host modules are measured by the separate >=75% gate.
# Keep their growth out of the retained legacy implementation's denominator.
[run]
source = mnemion
omit =
    */mnemion/service/*
    */mnemion/host_control/*
    */mnemion/local_*.py
    */mnemion/backup_encryption.py
    */mnemion/journal/*
    */mnemion/connectors/journal_projection.py
    */mnemion/capture_identity.py
    */mnemion/capture_coverage.py
    */mnemion/desktop_capture*.py
    */mnemion/desktop_source_status.py
    */mnemion/connectors/conversation_inbox.py
    */mnemion/connectors/conversation_capture.py
    */mnemion/connectors/capture_*.py
    */mnemion/connectors/headless_capture*.py

[report]
fail_under = 45
show_missing = true
exclude_lines =
    if __name__
    pragma: no cover
